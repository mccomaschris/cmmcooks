---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
const recipes = (await getCollection('recipes')).sort((a, b) => a.data.name.localeCompare(b.data.name));
const categories = (await getCollection('categories')).sort((a, b) => a.data.name.localeCompare(b.data.name));
const categoryNames = (ids: string[]) => ids.map((id) => categories.find((category) => category.id === id)?.data.name ?? id).join(' · ');
---
<BaseLayout title="CMM Cooks | Recipes">
  <div class="plain-wrap plain-index">
    <h1 class="sr-only">Recipes</h1>
    <div class="plain-controls">
      <input class="js-search" type="search" placeholder="Search recipes" aria-label="Search recipes" autocomplete="off" />
      <select class="js-category" aria-label="Filter by category"><option value="">All</option>{categories.map((category) => <option value={category.id}>{category.data.name}</option>)}</select>
    </div>
    <ul class="plain-list">
      {recipes.map((recipe) => <li data-name={recipe.data.name.toLocaleLowerCase()} data-categories={recipe.data.categories.join(' ')}><a href={`/recipes/${recipe.id}`}>{recipe.data.name}</a><span class="muted">{categoryNames(recipe.data.categories)}</span></li>)}
    </ul>
    <p class="plain-empty js-empty" hidden>No matches.</p>
  </div>
  <script>
    const search = document.querySelector<HTMLInputElement>('.js-search')!;
    const category = document.querySelector<HTMLSelectElement>('.js-category')!;
    const items = [...document.querySelectorAll<HTMLElement>('.plain-list li')];
    const empty = document.querySelector<HTMLElement>('.js-empty')!;
    const update = () => {
      const query = search.value.trim().toLocaleLowerCase();
      let visible = 0;
      for (const item of items) {
        const match = item.dataset.name!.includes(query) && (!category.value || item.dataset.categories!.split(' ').includes(category.value));
        item.hidden = !match;
        if (match) visible++;
      }
      empty.hidden = visible !== 0;
    };
    search.addEventListener('input', update);
    category.addEventListener('change', update);
    update();
  </script>
</BaseLayout>
