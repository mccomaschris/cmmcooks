---
import '../styles/global.css';
interface Props { title: string; description?: string }
const { title, description = 'Recipes from the CMM kitchen.' } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f9f7f2" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{title}</title>
  </head>
  <body>
    <header class="site-header">
      <div class="shell header-inner">
        <a class="brand" href="/" aria-label="CMM Cooks home"><span class="brand-mark">CMM</span><span>Cooks</span></a>
        <nav aria-label="Main navigation"><a href="/recipes">All recipes</a></nav>
      </div>
    </header>
    <main><slot /></main>
    <footer class="site-footer"><div class="shell">Made to cook, save, and share.</div></footer>
  </body>
</html>
