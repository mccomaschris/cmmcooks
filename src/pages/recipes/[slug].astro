---
import { getCollection, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  return (await getCollection('recipes')).map((recipe) => ({ params: { slug: recipe.id }, props: { recipe } }));
}
const { recipe } = Astro.props as { recipe: CollectionEntry<'recipes'> };
---
<BaseLayout title={`${recipe.data.name} | CMM Cooks`} description={recipe.data.description || `Ingredients and instructions for ${recipe.data.name}.`}>
  <div class="plain-wrap plain-detail">
    <a class="plain-back" href="/recipes">← Recipes</a>
    <div class="plain-title"><h1>{recipe.data.name}</h1><label class="plain-wake"><input id="wake-toggle" type="checkbox" /> Keep screen on</label></div>
    {recipe.data.description && <p class="muted">{recipe.data.description}</p>}
    {recipe.data.image && <img src={recipe.data.image} alt={recipe.data.name} />}
    <div class="plain-cols">
      <section><h2>Ingredients</h2><ul>{recipe.data.ingredients.map((ingredient) => <li>{ingredient.amount ? `${ingredient.amount} ` : ''}{ingredient.name}{ingredient.note && <small>{ingredient.note}</small>}</li>)}</ul></section>
      <section><h2>Instructions</h2><ol>{recipe.data.instructions.map((instruction) => <li>{instruction.name}{instruction.note && <small>{instruction.note}</small>}</li>)}</ol></section>
    </div>
    {recipe.data.note && <section class="plain-note"><h2>Notes</h2><p>{recipe.data.note}</p></section>}
  </div>
  <script>
    const toggle = document.querySelector<HTMLInputElement>('#wake-toggle')!;
    let lock: WakeLockSentinel | null = null;
    let wanted = false;
    async function acquire() {
      if (!wanted || document.visibilityState !== 'visible' || !('wakeLock' in navigator)) return;
      try {
        lock = await navigator.wakeLock.request('screen');
        lock.addEventListener('release', () => { lock = null; });
        toggle.checked = true;
      } catch {
        wanted = false;
        toggle.checked = false;
      }
    }
    toggle.addEventListener('change', async () => {
      wanted = toggle.checked;
      if (wanted) await acquire();
      else { await lock?.release(); lock = null; }
    });
    document.addEventListener('visibilitychange', () => {
      if (document.visibilityState === 'visible' && wanted && !lock) void acquire();
    });
    window.addEventListener('pagehide', () => { wanted = false; void lock?.release(); });
    if (!('wakeLock' in navigator)) {
      toggle.disabled = true;
      toggle.parentElement?.setAttribute('title', 'Screen wake lock is unavailable in this browser');
    }
  </script>
</BaseLayout>
